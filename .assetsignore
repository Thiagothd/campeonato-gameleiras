# Keep the project root as the Pages upload directory, but do not publish
# repository, deployment, or legacy hosting files as public assets.
.git/
.gitignore
.assetsignore
.wrangler/
node_modules/
.env
.env.*

# Backups (código antigo + dump do banco). Está no .gitignore, mas o deploy
# usa ESTE arquivo — sem esta linha a pasta era publicada e ficava acessível
# em /backups/... no site.
backups/

wrangler.toml
deploy-cloudflare-pages.ps1

.firebaserc
firebase.json
firestore.rules
LEIA-ME.md
CONTEXTO.md
campeonato-teste.html

assets/img/Esporte/
assets/img/Esporte.zip
assets/img/*.png
assets/img/*.jpg
assets/img/*.jpeg
assets/img/times/*.png
assets/img/times/*.jpg
assets/img/times/*.jpeg
# ...exceto a logo do rodapé, que é usada de verdade no site publicado:
!assets/img/LogoSemFundo.png

# Arquivos de preview/demo gerados localmente (dados fictícios) — nunca publicar:
preview-*.html
campeonato-teste.html

*.log
*.zip
